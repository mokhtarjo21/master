{
  "info": {
    "_postman_id": "815b729a-84cd-4abe-99c9-9d1ba0ee8443",
    "name": "Teacher Auth & Bulk Payments",
    "description": "APIs for Teacher Registration (PIN & Google), Login, and Bulk Payments",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Teacher Registration (PIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"teacher_kamel\",\n    \"email\": \"kamel@example.com\",\n    \"pin\": \"1234\",\n    \"center_name\": \"Kamel Center\",\n    \"first_name\": \"Ahmed\",\n    \"last_name\": \"Kamel\",\n    \"language\": \"ar\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/teacher-register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "teacher-register",
                ""
              ]
            }
          }
        },
        {
          "name": "2. Teacher Google Login/Signup",
          "request": {
            "method": "POST",
            "header": [
