              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"id_token\": \"ENTER_YOUR_VALID_GOOGLE_ID_TOKEN_HERE\",\n    \"device_info\": {\n        \"os\": \"Windows\",\n        \"browser\": \"Chrome\"\n    }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/teacher-google-login/",
